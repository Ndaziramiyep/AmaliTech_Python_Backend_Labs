# Root environment file for `docker-compose up` — orchestrates all three
# services. Copy to `.env` before running docker compose.
# For running a service outside Docker, use that service's own
# services/<name>/.env.example instead (copy it to services/<name>/.env).

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,auth-service,url-service,analytics-service

# --- Shared secrets --------------------------------------------------------
# Same value across all three services: lets url-service and analytics-service
# verify JWTs issued by auth-service without calling back to it.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key
# Same value across url-service and analytics-service: required as the
# X-Internal-Key header on analytics-service's click-event endpoint so it
# can't be hit from the public internet.
INTERNAL_API_KEY=change-me-shared-internal-key

# --- Per-service Django secret keys (local crypto only: admin/session/CSRF) -
AUTH_SECRET_KEY=django-insecure-change-me-auth
URL_SECRET_KEY=django-insecure-change-me-url
ANALYTICS_SECRET_KEY=django-insecure-change-me-analytics

# --- auth-service's database ------------------------------------------------
AUTH_POSTGRES_DB=auth_service
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=postgres

# --- url-service's database -------------------------------------------------
URL_POSTGRES_DB=url_service
URL_POSTGRES_USER=postgres
URL_POSTGRES_PASSWORD=postgres

# --- analytics-service's database ------------------------------------------
ANALYTICS_POSTGRES_DB=analytics_service
ANALYTICS_POSTGRES_USER=postgres
ANALYTICS_POSTGRES_PASSWORD=postgres

# url-service builds short_link values (e.g. http://localhost:8002/abc123/) from this.
BASE_URL=http://localhost:8002

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
