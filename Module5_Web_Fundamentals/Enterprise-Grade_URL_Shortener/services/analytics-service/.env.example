DEBUG=True
SECRET_KEY=django-insecure-change-me-analytics
ALLOWED_HOSTS=localhost,127.0.0.1

# Must match auth-service's JWT_SECRET_KEY — this service verifies tokens
# issued by auth-service without calling back to it.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key

# Must match url-service's INTERNAL_API_KEY — required on the click-event
# endpoint as X-Internal-Key so it can't be hit from the public internet.
INTERNAL_API_KEY=change-me-shared-internal-key

POSTGRES_DB=analytics_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
