DEBUG=True
SECRET_KEY=django-insecure-change-me-analytics
# "analytics" is the alias the API gateway's server.conf uses for this
# service on the shared gateway network (its /api/v1/docs/analytics/ proxy
# loses the gateway's own Host override once it sets its own
# proxy_set_header, so this service sees Host: analytics:8000) — only needed
# if you're running the gateway.
ALLOWED_HOSTS=localhost,127.0.0.1,analytics-service,analytics

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8003

# Must match auth-service's JWT_SECRET_KEY — this service verifies tokens
# issued by auth-service without calling back to it.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key

# Must match url-service's INTERNAL_API_KEY — required on the click-event
# endpoint as X-Internal-Key so it can't be hit from the public internet.
INTERNAL_API_KEY=change-me-shared-internal-key

# analytics-db is this service's docker-compose service/container name —
# reachable under that name only from inside the docker network. Running
# manage.py directly on the host instead, override both at the shell first:
#   POSTGRES_HOST=localhost POSTGRES_PORT=5435 python manage.py runserver
POSTGRES_DB=analytics_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=patrick
POSTGRES_HOST=analytics-db
POSTGRES_PORT=5432

# redis is this service's docker-compose service/container name — reachable
# under that name only from inside the docker network. Backs the Celery
# broker used for write-behind click-event persistence (see analytics/tasks.py).
# Running manage.py/celery directly on the host instead, override:
#   CELERY_BROKER_URL=redis://127.0.0.1:6381/0
CELERY_BROKER_URL=redis://redis:6379/0

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Enables ?profile=1 request profiling (see README's Performance Tuning
# section). Off by default — leave off in production unless you're actively
# investigating something, since a profiled request runs slower.
ENABLE_PROFILING=False

# Gunicorn tuning (read directly from this file by gunicorn.conf.py, not by
# Django) — sensible defaults apply if left unset. See README for the full
# list of GUNICORN_* knobs (workers, threads, timeouts, worker recycling).
# GUNICORN_WORKERS=3
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_THREADS=4
