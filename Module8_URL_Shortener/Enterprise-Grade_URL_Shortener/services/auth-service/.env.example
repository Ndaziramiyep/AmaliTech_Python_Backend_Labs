DEBUG=True
SECRET_KEY=django-insecure-change-me-auth
ALLOWED_HOSTS=localhost,127.0.0.1,auth-service

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8001

# Must be identical across auth-service, url-service, and analytics-service —
# it's how the other two services verify access tokens issued here without
# calling back to this service.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key

# auth-db is this service's docker-compose service/container name — reachable
# under that name only from inside the docker network. Running manage.py
# directly on the host instead, override both at the shell first:
#   POSTGRES_HOST=localhost POSTGRES_PORT=5434 python manage.py runserver
POSTGRES_DB=auth_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=patrick
POSTGRES_HOST=auth-db
POSTGRES_PORT=5432

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
