# Points at a locally installed Postgres server (e.g. the one visible in
# pgAdmin), not the docker-compose container - replace the password and
# database name with your own.
POSTGRES_DSN=postgresql://postgres:your-local-password@localhost:5432/Social-MediaDB
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
REDIS_URL=redis://localhost:6380/0
REDIS_TIMELINE_TTL_SECONDS=60
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=social_activity
