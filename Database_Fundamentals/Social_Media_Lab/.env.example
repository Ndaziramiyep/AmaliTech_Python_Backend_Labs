# Matches docker-compose.yml's postgres service. pgAdmin can connect
# directly to this container via localhost:5433 to view the data.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=social
POSTGRES_USER=social
POSTGRES_PASSWORD=social
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
REDIS_URL=redis://localhost:6380/0
REDIS_TIMELINE_TTL_SECONDS=60
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=social_activity
