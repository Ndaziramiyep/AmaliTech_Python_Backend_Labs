DEBUG=True
SECRET_KEY=django-insecure-change-me-preview
# "preview" is the alias the API gateway's server.conf uses for this
# service on the shared gateway network — only needed if you're running
# the gateway (this service has no docs/admin gateway route since it's
# internal-only, but ALLOWED_HOSTS still needs it for the Host header
# url-service's own request arrives with).
ALLOWED_HOSTS=localhost,127.0.0.1,preview-service,preview

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8004

# Must match url-service's INTERNAL_API_KEY — required on the preview
# endpoint as X-Internal-Key so it can't be hit from the public internet.
INTERNAL_API_KEY=change-me-shared-internal-key

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
# Irrelevant in practice — this service is never called from a browser,
# only server-to-server from url-service — kept for parity with the others.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
