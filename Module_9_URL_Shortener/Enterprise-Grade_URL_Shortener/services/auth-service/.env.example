DEBUG=True
SECRET_KEY=django-insecure-change-me-auth
# "auth" is this service's name in the gateway's nginx.conf (it sets
# Host: auth on its internal-verify subrequest) — only needed if you're
# running the gateway.
ALLOWED_HOSTS=localhost,127.0.0.1,auth-service,auth

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8001

# Must be identical across auth-service, url-service, and analytics-service —
# it's how the other two services verify access tokens issued here without
# calling back to this service.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key

# Shared only with the API gateway (gateway/.env) — checked as
# X-Internal-Token on this service's internal token-validation endpoint,
# which the gateway calls on every request to a protected
# url-service/analytics-service route.
INTERNAL_SERVICE_TOKEN=change-me-shared-gateway-token

# auth-db is this service's name in the root-level docker-compose.yml —
# reachable under that name only from inside the docker network. Running
# manage.py directly on the host instead, override both at the shell first:
#   POSTGRES_HOST=localhost POSTGRES_PORT=5434 python manage.py runserver
POSTGRES_DB=auth_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=patrick
POSTGRES_HOST=auth-db
POSTGRES_PORT=5432

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Enables ?profile=1 request profiling (see README's Performance Tuning
# section). Off by default — leave off in production unless you're actively
# investigating something, since a profiled request runs slower.
ENABLE_PROFILING=False

# Gunicorn tuning (read directly from this file by gunicorn.conf.py, not by
# Django) — sensible defaults apply if left unset. See README for the full
# list of GUNICORN_* knobs (workers, threads, timeouts, worker recycling).
# GUNICORN_WORKERS=3
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_THREADS=4
