DEBUG=True
SECRET_KEY=django-insecure-change-me-url
# "shortener" is this service's name in the gateway's nginx.conf (its
# /api/v1/docs/shortener/ proxy loses the gateway's own Host override once it
# sets its own proxy_set_header, so this service sees Host: shortener:8000) —
# only needed if you're running the gateway.
ALLOWED_HOSTS=localhost,127.0.0.1,url-service,shortener

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8002

# Must match auth-service's JWT_SECRET_KEY — this service verifies tokens
# issued by auth-service without calling back to it.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key

# Must match analytics-service's INTERNAL_API_KEY — sent as X-Internal-Key
# when reporting click events so analytics-service can tell the call came
# from this service and not the public internet.
INTERNAL_API_KEY=change-me-shared-internal-key

# "analytics" is this service's name in the root-level docker-compose.yml —
# reachable under that name only from inside the docker network. If
# analytics isn't part of this run at all, click reporting just fails
# its request and logs a warning (see clients/analytics_client.py); redirects
# still work. Running manage.py directly on the host instead, override:
#   ANALYTICS_SERVICE_URL=http://localhost:8003
ANALYTICS_SERVICE_URL=http://analytics:8000

# Must match url-preview's own INTERNAL_SERVICE_TOKEN — sent as
# X-Internal-Token when requesting a preview fetch right after a URL is
# created. "url-preview" is this service's name in the root-level
# docker-compose.yml; if it isn't part of this run at all, the preview fetch
# just fails and logs a warning (see clients/preview_client.py) — URL
# creation still succeeds, just without a title/description/favicon.
URL_PREVIEW_SERVICE_URL=http://url-preview:8000
URL_PREVIEW_INTERNAL_TOKEN=change-me-shared-internal-token

# url-db/url-redis are this service's names in the root-level
# docker-compose.yml — reachable under those names only from inside the
# docker network. Running manage.py directly on the host instead, override
# all three first:
#   POSTGRES_HOST=localhost POSTGRES_PORT=5436 REDIS_URL=redis://127.0.0.1:6380/1 python manage.py runserver
POSTGRES_DB=url_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=patrick
POSTGRES_HOST=url-db
POSTGRES_PORT=5432

REDIS_URL=redis://url-redis:6379/1

# Celery broker — same redis container as REDIS_URL above but a different DB
# index, so task queue keys never collide with cached URL lookups. Running
# manage.py/celery directly on the host instead, override:
#   CELERY_BROKER_URL=redis://127.0.0.1:6380/2
CELERY_BROKER_URL=redis://url-redis:6379/2

BASE_URL=http://localhost:8002

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Enables ?profile=1 request profiling (see README's Performance Tuning
# section). Off by default — leave off in production unless you're actively
# investigating something, since a profiled request runs slower.
ENABLE_PROFILING=False

# Gunicorn tuning (read directly from this file by gunicorn.conf.py, not by
# Django) — sensible defaults apply if left unset. See README for the full
# list of GUNICORN_* knobs (workers, threads, timeouts, worker recycling).
# GUNICORN_WORKERS=3
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_THREADS=4
