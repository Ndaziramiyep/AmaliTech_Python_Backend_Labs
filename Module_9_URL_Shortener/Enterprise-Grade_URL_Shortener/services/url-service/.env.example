DEBUG=True
SECRET_KEY=django-insecure-change-me-url
# "shortener" is the alias the API gateway's server.conf uses for this service
# on the shared gateway network (its /api/v1/docs/shortener/ proxy loses the
# gateway's own Host override once it sets its own proxy_set_header, so this
# service sees Host: shortener:8000) — only needed if you're running the gateway.
ALLOWED_HOSTS=localhost,127.0.0.1,url-service,shortener

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8002

# Must match auth-service's JWT_SECRET_KEY — this service verifies tokens
# issued by auth-service without calling back to it.
JWT_SECRET_KEY=change-me-shared-jwt-signing-key

# Must match analytics-service's INTERNAL_API_KEY — sent as X-Internal-Key
# when reporting click events so analytics-service can tell the call came
# from this service and not the public internet.
INTERNAL_API_KEY=change-me-shared-internal-key

# "analytics" is analytics-service's alias on the shared gateway-net network
# (see gateway/docker-compose.yml and analytics-service/docker-compose.yml) —
# reachable under that name only from inside the docker network, and only
# once analytics-service is part of this run and gateway-net exists. If
# analytics-service isn't part of this run at all, click reporting is queued
# via Celery and retried with backoff until it is (see
# clients/analytics_client.py and tasks.py); redirects still work either way.
# Running manage.py directly on the host instead, override:
#   ANALYTICS_SERVICE_URL=http://localhost:8003
ANALYTICS_SERVICE_URL=http://analytics:8000

# "preview" is preview-service's alias on the shared gateway-net network
# (see gateway/docker-compose.yml and preview-service/docker-compose.yml) —
# reachable under that name only from inside the docker network, and only
# once preview-service is part of this run and gateway-net exists. If
# preview-service isn't part of this run at all, the preview fetch is
# queued via Celery and retried with backoff until it is (see
# clients/preview_client.py and tasks.py); URL creation still works either
# way, just without a title/description/favicon until the fetch succeeds.
# Running manage.py directly on the host instead, override:
#   PREVIEW_SERVICE_URL=http://localhost:8004
PREVIEW_SERVICE_URL=http://preview:8000

# url-db/redis are this service's docker-compose service/container names —
# reachable under those names only from inside the docker network. Running
# manage.py directly on the host instead, override all three first:
#   POSTGRES_HOST=localhost POSTGRES_PORT=5436 REDIS_URL=redis://127.0.0.1:6380/1 python manage.py runserver
POSTGRES_DB=url_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=patrick
POSTGRES_HOST=url-db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1

# Celery broker — same redis container as REDIS_URL above but a different DB
# index, so task queue keys never collide with cached URL lookups. Running
# manage.py/celery directly on the host instead, override:
#   CELERY_BROKER_URL=redis://127.0.0.1:6380/2
CELERY_BROKER_URL=redis://redis:6379/2

BASE_URL=http://localhost:8002

# Comma-separated list of allowed frontend origins, e.g. https://myapp.com
# Leave CORS_ALLOWED_ORIGINS empty and CORS_ALLOW_ALL_ORIGINS=True for local dev only.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
