DEBUG=True
SECRET_KEY=django-insecure-change-me-url-preview

# Comma-separated allowed hosts — the "*" wildcard is not permitted (see
# config/settings.py). "url-preview" is this service's name in the root
# services/docker-compose.yml.
ALLOWED_HOSTS=localhost,127.0.0.1,url-preview

# Port `manage.py runserver` binds to when run locally without an explicit
# addrport argument (matches this service's docker-compose host port).
PORT=8004

# url-preview-db is this service's own Postgres container/service name —
# reachable under that name only from inside the docker network. Running
# manage.py directly on the host instead, override both at the shell first:
#   DB_HOST=localhost DB_PORT=5437 python manage.py runserver
DB_NAME=url_preview
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=url-preview-db
DB_PORT=5432

# Same three values again, under the official postgres image's own expected
# names — services/docker-compose.yml's url-preview-db service reads these
# (not DB_NAME/DB_USER/DB_PASSWORD above, which are Django's names) via this
# same .env file to initialize itself. Keep all three pairs in sync.
POSTGRES_DB=url_preview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# url-preview-redis is this service's own Redis container/service name —
# backs both the short result cache and the per-domain circuit breaker.
REDIS_URL=redis://url-preview-redis:6379/0

# Must match shortener's (url-service's) own copy of the same value — sent
# as X-Internal-Token, checked by IsInternalService on this service's one
# endpoint (POST /api/v1/internal/preview/).
INTERNAL_SERVICE_TOKEN=change-me-shared-internal-token

# Per-attempt HTTP request timeout, in seconds.
PREVIEW_FETCH_TIMEOUT=5.0
# Retry attempts per fetch, including the first.
PREVIEW_MAX_ATTEMPTS=3
# Base delay for exponential backoff between attempts, in seconds.
PREVIEW_RETRY_BASE_DELAY=0.5
# Cap on the response body read per fetch, in bytes.
PREVIEW_MAX_BODY_BYTES=2000000
# Failures (within a ~120s sliding window) before a domain's circuit opens.
PREVIEW_CIRCUIT_FAILURE_THRESHOLD=5
# How long an open circuit blocks a domain before the next trial call, in seconds.
PREVIEW_CIRCUIT_OPEN_SECONDS=60
# How long a successful fetch result is cached, in seconds.
PREVIEW_CACHE_TTL=600

# Comma-separated list of allowed frontend origins — irrelevant in practice
# (this service is never called from a browser, only server-to-server from
# url-service), kept only for parity with the other services' settings.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Gunicorn tuning (read directly from this file by gunicorn.conf.py, not by
# Django) — sensible defaults apply if left unset.
# GUNICORN_WORKERS=3
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_THREADS=4
