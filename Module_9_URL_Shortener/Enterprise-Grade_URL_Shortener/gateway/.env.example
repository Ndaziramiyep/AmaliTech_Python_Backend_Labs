# Must be identical to auth-service's own INTERNAL_SERVICE_TOKEN
# (services/auth-service/.env) — sent as X-Internal-Token on the
# /internal/verify auth_request subrequest, checked there by IsInternalGateway.
INTERNAL_SERVICE_TOKEN=change-me-shared-gateway-token

# The one frontend origin allowed to make credentialed cross-origin requests
# through this gateway (scheme + host + port, no trailing slash). See README.md.
CORS_ALLOWED_ORIGIN=http://localhost:3000
